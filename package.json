    "@tauri-apps/plugin-opener": "^2",
    "loading-dev": "^0.3.4",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "torph": "^0.1.3"
