{
  "name": "openleash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpenLeash - desktop agent harness (Tauri + Rust)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevLeashed/OpenLeash.git"
  },
  "homepage": "https://github.com/DevLeashed/OpenLeash",
