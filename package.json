  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0"
  },
  "scripts": {
    "dev": "npm run version:check && vite",
    "build": "npm run version:check && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run version:check && npm run typecheck && npm run lint && npm test",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs",
    "version": "node scripts/version.mjs --sync"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.95.1",
